{
  "name": "dsh-tiaforge",
  "version": "0.9.5",
  "description": "DSH 博途插件：在 DeepSeek Harness 里接西门子 TIA Portal —— 文档检索、梯形图生成与渲染、PLC 云仿真、本机网关（TiaLink）。带本地配置页（npx dsh-tiaforge-setup）：改 Key/URL 不用重启。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "lib",
    "bin",
    "assets",
    "test"
  ],
  "bin": {
    "dsh-tiaforge-setup": "./bin/setup.mjs"
  },
  "scripts": {
    "test": "node --test test/patch.test.mjs test/credentials-file.test.mjs test/keys.test.mjs test/setup-tools.test.mjs test/gateway-patch.test.mjs test/wording.test.mjs test/doc-lint.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "tia-portal",
    "siemens",
    "plc",
    "scl",
    "lad",
    "mcp"
  ],
  "license": "MIT",
  "author": {
    "name": "汇智网 (hubwiz.com)",
    "email": "support@hubwiz.com",
    "url": "https://tia.hubwiz.com/"
  },
  "homepage": "https://tia.hubwiz.com/?utm_source=npm&utm_medium=readme&utm_campaign=dsh-tiaforge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tia-forge/dsh-tiaforge.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.0 <0.2.1-rc.0 || >=0.2.1-rc.0 <0.3.0",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
